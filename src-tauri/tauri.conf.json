{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "skilltopia",
  "version": "0.2.0",
  "identifier": "co.coduo.skilltopia",
  "build": {
    "removeUnusedCommands": true,
    "beforeDevCommand": "npm run dev:desktop",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:desktop",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Skilltopia",
        "width": 1920,
        "height": 1080,
        "minWidth": 1200,
        "minHeight": 800,
        "resizable": true,
        "fullscreen": false,
        "maximized": true,
        "center": true,
        "decorations": true,
        "alwaysOnTop": false,
        "transparent": false,
        "shadow": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' tauri: ipc: http://ipc.localhost"
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "createUpdaterArtifacts": true,
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Coduo Studio, LLC",
    "category": "DeveloperTool",
    "shortDescription": "Skilltopia is a platform for managing your AI agent skills and downloading them from the web.",
    "longDescription": "Skilltopia is a platform for managing your AI agent skills and downloading them from the web. It is a tool for developers to create and manage their AI agent skills.",
    "copyright": "Copyright © 2026 Coduo. All rights reserved.",
    "macOS": {
      "frameworks": [],
      "minimumSystemVersion": "10.15",
      "signingIdentity": "-",
      "providerShortName": null,
      "entitlements": null,
      "exceptionDomain": ""
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": ["https://github.com/sahildave/skilltopia/releases/latest/download/latest.json"],
      "dialog": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENBRTg0QkEyMkFDRDgyQzMKUldURGdzMHFva3ZveWk5K2c5anZYb2xOYlB3QmpIL0dRS1R5N1JBRzUycmFodTJRN2doUHZvUTkK"
    }
  }
}
